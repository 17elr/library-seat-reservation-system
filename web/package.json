{
  "name": "library-seat-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 18083 --strictPort",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests e2e *.js package.json",
    "format:check": "prettier --check src tests e2e *.js package.json",
    "format:java": "prettier --plugin=prettier-plugin-java --tab-width 4 --write \"../src/**/*.java\"",
    "format:java:check": "prettier --plugin=prettier-plugin-java --tab-width 4 --check \"../src/**/*.java\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "element-plus": "2.11.5",
    "vue": "3.5.44",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-vue": "6.0.1",
    "prettier": "3.6.2",
    "prettier-plugin-java": "2.11.0",
    "vite": "7.3.7"
  }
}
